rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra quyền Admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Quy tắc cho Phòng Chat cộng đồng (Ai cũng đọc được, đăng nhập mới được chat)
    match /chats/{chatId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // 2. Quy tắc cho Người dùng (Bảo mật tối đa, chặn hack tiền/role/hack giờ vàng)
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.balance == 0
                    && request.resource.data.role == 'user';
      
      allow update: if request.auth != null && (
        (request.auth.uid == userId 
         && request.resource.data.role == resource.data.role // Không được tự đổi role
         && request.resource.data.balance <= resource.data.balance // Không được tự tăng tiền
         // Kiểm tra chặt chẽ giờ vàng Ad-Free (Chống hack F12)
         && (
           request.resource.data.get('adFreeUntil', 0) == resource.data.get('adFreeUntil', 0) || (
             request.resource.data.get('lastAdClaimed', 0) == request.time.toMillis() &&
             request.time.toMillis() >= resource.data.get('lastAdClaimed', 0) + 180000 &&
             (
               (resource.data.get('adFreeUntil', 0) > request.time.toMillis() && request.resource.data.get('adFreeUntil', 0) <= resource.data.get('adFreeUntil', 0) + 420000) ||
               (resource.data.get('adFreeUntil', 0) <= request.time.toMillis() && request.resource.data.get('adFreeUntil', 0) <= request.time.toMillis() + 420000)
             )
           )
         )
        )
        || isAdmin() // Trừ khi là admin
      );
      
      allow delete: if request.auth != null && isAdmin();

      // Cho phép ghi lại lịch sử nhận thưởng (subcollection)
      match /ad_claims/{claimId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.minutes >= 3 
                      && request.resource.data.minutes <= 7;
      }
    }

    // 3. Quy tắc cho Blog & Bình luận Blog
    match /blogs/{blogId} {
      allow read: if true;
      // Chỉ Admin được tạo/xóa bài viết
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin() 
        // User bình thường chỉ được phép tăng view (không được sửa nội dung)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1)
      );
    }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Quy tắc cho Game trong store
    match /games/{gameId} {
      allow read: if true;
      // Chỉ Admin được thêm, sửa, xóa Game
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin()
        // User bình thường chỉ được phép tải game (tăng view/lượt tải nếu có)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1)
      );
    }

    // 4b. Quy tắc cho Sticker
    match /stickers/{stickerId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // 5. Quy tắc cho Video & Bình luận Video
    match /videos/{videoId} {
      allow read: if true;
      allow create, delete: if request.auth != null && isAdmin();
      allow update: if request.auth != null && (
        isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1)
      );
    }
    match /video_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 6. Quy tắc cho bảng Báo lỗi & Hỗ trợ (User chỉ xem/tạo của mình)
    match /reports/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && isAdmin();
    }

    match /error_reports/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null; // Ai cũng xem được báo lỗi chung
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // 7. Quy tắc cho bảng Ví nạp tiền (Cực kỳ quan trọng: chặn user tự đổi status thành công)
    match /payments/{document} {
      allow read: if request.auth != null;
      
      // User chỉ được tạo hóa đơn ở trạng thái "pending"
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      
      // User không được tự sửa đổi nội dung hóa đơn (đặc biệt là status)
      allow update: if request.auth != null 
                    && (isAdmin()
                        || (request.resource.data.userId == request.auth.uid 
                            && request.resource.data.status == resource.data.status));
      
      // Chặn xóa
      allow delete: if request.auth != null && isAdmin();
    }
  }
}
